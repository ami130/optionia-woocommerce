# Optionia WooCommerce Backend — environment template
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# ⚠️  PLACEHOLDERS ONLY IN THIS FILE.
# Every value here is committed to version control. A real credential written
# here is a leaked credential, permanently, even if removed in a later commit.
#
# There are NO fallback defaults in code. A missing or empty required variable
# throws at boot rather than silently defaulting — a silent default is how a
# local process ends up talking to a production database.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Database
#
# This service owns its database exclusively. It must not share one with any
# other application.
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=optionia_woo_dev
DB_USER=changeme
DB_PASSWORD=changeme

# TLS is required in staging and production. Local MySQL typically has none.
DB_SSL=false

# ---------------------------------------------------------------------------
# Security
#
# Generate with: openssl rand -base64 48
# Rotating JWT_SECRET invalidates every existing session, by design.
# ---------------------------------------------------------------------------
JWT_SECRET=changeme-generate-a-long-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated allowlist. Never "*".
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
