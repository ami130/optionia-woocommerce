# Optionia WooCommerce Backend — environment template
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# ⚠️  PLACEHOLDERS ONLY IN THIS FILE.
# Every value here is committed to version control. A real credential written
# here is a leaked credential, permanently, even if removed in a later commit.
#
# There are NO fallback defaults in code. A missing or empty required variable
# throws at boot rather than silently defaulting — a silent default is how a
# local process ends up talking to a production database.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Database
#
# This service owns its database exclusively. It must not share one with any
# other application.
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=optionia_woo_dev
DB_USER=changeme
DB_PASSWORD=changeme

# TLS is required in staging and production. Local MySQL typically has none.
DB_SSL=false

# ---------------------------------------------------------------------------
# Security
#
# Generate with: openssl rand -base64 48
# Rotating JWT_SECRET invalidates every existing session, by design.
# ---------------------------------------------------------------------------
JWT_SECRET=changeme-generate-a-long-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated allowlist. Never "*".
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Transactional mail
# ---------------------------------------------------------------------------
# Leave SMTP_HOST empty and every message is written to the ops log instead of
# being sent. That is the right default for tests and for a fresh checkout — the
# first person to run the suite must not mail a stranger.
#
# Production refuses to boot without it: a discarded verification email is
# indistinguishable from a working system until a merchant reports never
# receiving one.
#
# Development uses authenticated SMTP. The production provider is still open —
# SMTP has no delivery webhook, so bounces cannot be detected (see D4).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# For Gmail this is an app password, not the account password. Treat it as a
# credential: it is never committed, and it is rotated if it is ever pasted
# anywhere outside this file.
SMTP_PASS=
# Implicit TLS on 465, STARTTLS on 587. Inferred from the port unless set.
# SMTP_SECURE=false

MAIL_FROM=Optionia <no-reply@parselab.com>

# Where the dashboard lives. Every link in an email is built from this, so it is
# the dashboard's address and not the API's — a merchant who lands on a JSON
# endpoint has hit a dead end that looks like a broken product.
# Required in production; defaults to the Next.js dev port otherwise.
APP_URL=http://localhost:3000
