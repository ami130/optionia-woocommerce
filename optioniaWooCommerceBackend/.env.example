# Optionia WooCommerce Backend — environment template
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# ⚠️  PLACEHOLDERS ONLY IN THIS FILE.
# Every value here is committed to version control. A real credential written
# here is a leaked credential, permanently, even if removed in a later commit.
#
# There are NO fallback defaults in code. A missing or empty required variable
# throws at boot rather than silently defaulting — a silent default is how a
# local process ends up talking to a production database.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Database
#
# This service owns its database exclusively. It must not share one with any
# other application.
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=optionia_woo_dev
DB_USER=changeme
DB_PASSWORD=changeme

# 🔴 **An empty DB_PASSWORD is a missing one.** `config/env.ts` reads it through
# `required()`, which throws on `''` as well as on absent — "there are no
# defaults by design". So the common local setup of root-with-no-password does
# **not** work here, and the error names DB_PASSWORD without saying that empty
# counts as missing. Create a MySQL user with a password instead; weakening the
# check would remove what stops a blank production credential booting.

# TLS is required in staging and production. Local MySQL typically has none.
DB_SSL=false

# ---------------------------------------------------------------------------
# Security
#
# Generate with: openssl rand -base64 48
# Rotating JWT_SECRET invalidates every existing session, by design.
# ---------------------------------------------------------------------------
JWT_SECRET=changeme-generate-a-long-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated allowlist. Never "*".
#
# ⚠️ Set this to the port your dashboard actually runs on. Next picks the next
# free port when 3000 is taken, so a machine already running something there
# serves the dashboard from 3001 — and every API call then fails CORS with no
# hint that the port is the reason.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Transactional mail
# ---------------------------------------------------------------------------
# Leave SMTP_HOST empty and every message is written to the ops log instead of
# being sent. That is the right default for tests and for a fresh checkout — the
# first person to run the suite must not mail a stranger.
#
# Production refuses to boot without it: a discarded verification email is
# indistinguishable from a working system until a merchant reports never
# receiving one.
#
# Development uses authenticated SMTP. The production provider is still open —
# SMTP has no delivery webhook, so bounces cannot be detected (see D4).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# For Gmail this is an app password, not the account password. Treat it as a
# credential: it is never committed, and it is rotated if it is ever pasted
# anywhere outside this file.
SMTP_PASS=
# Implicit TLS on 465, STARTTLS on 587. Inferred from the port unless set.
# SMTP_SECURE=false

MAIL_FROM=Optionia <no-reply@parselab.com>

# Where the dashboard lives. Every link in an email is built from this, so it is
# the dashboard's address and not the API's — a merchant who lands on a JSON
# endpoint has hit a dead end that looks like a broken product.
# Required in production; defaults to the Next.js dev port otherwise.
#
# 🔴 **Check this matches your running dashboard.** `authorize_url` is built from
# it, so a stale value sends a merchant *mid-handshake* to whatever occupies that
# port. Measured on a development machine where port 3000 held an unrelated
# project: the store-connection flow handed the approval step to a stranger's
# site, and nothing in the flow looked wrong until it failed.
APP_URL=http://localhost:3000

# --- Rate limiting -----------------------------------------------------------
# Per-IP throttle ceilings, overridable so production can be tuned without a
# deploy. Two windows: `short` absorbs bursts, `sustained` bounds slow abuse —
# one window cannot do both.
#
# These are the GLOBAL fallback. Auth routes set their own, tighter limits in
# the controller and are unaffected by these values.
#
# The e2e suite raises them (test/setup-e2e.ts): every suite calls from one
# address, so a fast run trips a limit a real user never would. Raising the
# ceiling is not disabling the guard — it still runs and still keys per IP.
# THROTTLE_SHORT_LIMIT=20
# THROTTLE_DEFAULT_LIMIT=300
# THROTTLE_SUSTAINED_LIMIT=300
#
# 🔴 **The per-route auth caps now have their own variable**, because raising
# the globals above does NOT reach them — the line five comments up says so, and
# the dashboard's canonical E2E proved it: `POST /auth/refresh` is capped at 60
# an hour, several runs exhausted it, and from then on **every navigation landed
# on "Sign in"** while the suite reported a missing empty state.
#
# Leave it unset in production. 60/hour is a brute-force control on the one
# route that mints access tokens.
# THROTTLE_REFRESH_LIMIT=100000
