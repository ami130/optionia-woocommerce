# The API this dashboard talks to. No trailing slash.
#
# `NEXT_PUBLIC_` because the browser makes these calls directly: the dashboard is
# a client of the same public API the plugin uses, not a server-side proxy for
# it. Nothing secret belongs in this file — a `NEXT_PUBLIC_` value is compiled
# into the bundle and readable by anyone who opens the page.
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
